{
  "name": "@anthony-bonta-gaf-energy/gafe-interview-react",
  "version": "0.0.0",
  "description": "A project for interviews.",
  "author": "Anthony Bonta",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthony-bonta-gaf-energy/can-i-has-interview"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/stats'",
    "test": "vitest run --coverage",
    "build": "lerna run build",
    "check": "tsc --noEmit",
    "make": "npm run clean && npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "lerna": "^10.0.0",
    "lodash-es": "^4.18.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "nx@23.1.1": true
  },
  "packageManager": "yarn@4.18.0"
}
